{
  "name": "quiet-firefly-3711",
  "compatibility_date": "2026-07-03",
  "observability": {
    "enabled": true
  },
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The asset router answers before the Worker, so without this the 404 page
    // wins and /packing-slip never reaches the auth check.
    "run_worker_first": ["/packing-slip*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
