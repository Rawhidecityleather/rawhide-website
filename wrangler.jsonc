{
  "name": "quiet-firefly-3711",
  "compatibility_date": "2026-07-03",
  "observability": {
    "enabled": true
  },
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The asset router answers before the Worker, so anything the Worker has
    // to see must be listed here or it never runs.
    //
    // "/*" — the www -> apex 301 lives at the top of the Worker's fetch, and it
    // has to cover every page on the www host, not a list of paths. That means
    // every request goes through the Worker now. The paths that already needed
    // it are covered by the same wildcard: /dashboard* and /packing-slip* (the
    // auth check), /quote* (no file on disk, the Worker builds the page), and
    // /product-page* (the old Wix URL shape, redirected to the live product).
    //
    // "!/assets/*" — CSS, JS and images skip the Worker and go straight to the
    // asset router. They're the bulk of the requests and there is nothing for
    // the Worker to do to them. Redirecting an image host does nothing for
    // search either; only the HTML pages are indexed as pages.
    //
    // No slash before the star. "/quote/*" does not match and the quote pages
    // silently fall through to the 404 page — verified against production.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Abandoned cart recovery, step 3. Hourly, not daily: a cart crossing the
  // 72 hour mark then waits at most an hour rather than until whatever time of
  // day a daily run fires. Each run is cheap — one Snipcart list call, and
  // nothing else unless a cart is actually due. See worker/recovery.js.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  // QUOTES  — custom-build quotes. Created 2026-08-06 with
  //             wrangler kv namespace create QUOTES
  // RECOVERY — one record per abandoned cart we have emailed, holding the code
  //            minted for it. This is what stops the hourly cron from mailing
  //            the same person every hour for a week. Created 2026-08-17 with
  //             wrangler kv namespace create RECOVERY
  // EXPENSES — the receipt ledger: one record per receipt, with the row's
  //            summary in the key's metadata so a year lists in one call.
  //            Created 2026-08-18 with
  //             wrangler kv namespace create EXPENSES
  "kv_namespaces": [
    { "binding": "QUOTES", "id": "272cd3400d3e4eae945bfbe2b16ab43f" },
    { "binding": "RECOVERY", "id": "be611b5493984061803449b43657eec4" },
    { "binding": "EXPENSES", "id": "ccebdcbdddf74b93ab4c528138271837" }
  ],
  // LOGOS    — customer artwork for custom stamp work. Created with
  //             wrangler r2 bucket create rawhide-logo-uploads
  // RECEIPTS — the shop's own receipt photos, behind the same login. Created
  //            2026-08-18 with
  //             wrangler r2 bucket create rawhide-receipts
  // Nothing in either is public: /logo/<key> and /receipt/<key> both sit behind
  // the dashboard login.
  "r2_buckets": [
    { "binding": "LOGOS", "bucket_name": "rawhide-logo-uploads" },
    { "binding": "RECEIPTS", "bucket_name": "rawhide-receipts" }
  ],
  // Reads the vendor, date and total off a receipt photo so the row arrives
  // mostly filled in. Every field it returns is a suggestion the shop confirms
  // — see worker/receipts.js. Nothing breaks without it; rows just start empty.
  "ai": {
    "binding": "AI"
  },
  // Turns an iPhone's HEIC into a JPEG at upload. Without it a HEIC receipt is
  // stored as-is and is unreadable three ways over — the model can't decode it,
  // and no browser but Safari will draw it, so the thumbnail and the image in
  // the printed CPA packet both come out broken. Billed per transformation, and
  // only ever runs on a HEIC. See heicToJpeg in worker/receipts.js.
  "images": {
    "binding": "IMAGES"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
